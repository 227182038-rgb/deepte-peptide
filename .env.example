# Environment Configuration Example for DeepTE-Peptide
# Copy this file to .env and configure local paths or API tokens as needed.

DEEPTE_DATA_DIR=data
DEEPTE_RESULTS_DIR=results
DEEPTE_CONFIG_DIR=config

# Optional MLflow tracking
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=deepte-peptide

# Hardware & Determinism
DETERMINISTIC_CUDNN=1
CUBLAS_WORKSPACE_CONFIG=:4096:8
PYTHONHASHSEED=42
